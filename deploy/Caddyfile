# The one public door of a ReelForge server (docs/DEPLOY_AZURE.md).
# Caddy gets and renews the HTTPS certificate for DOMAIN by itself.
#
#   /api/*            -> the API
#   /<bucket>/*       -> file storage (the signed, short-lived links the API hands out)
#   everything else   -> the web app's files; unknown paths get index.html (a single-page app)

{$DOMAIN} {
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy api:5000
	}

	@media path /{$S3_BUCKET}/*
	handle @media {
		# The Host header is passed on unchanged: the links are signed for this address.
		reverse_proxy minio:9000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
