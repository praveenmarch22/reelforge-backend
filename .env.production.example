# ReelForge production settings (docs/DEPLOY_AZURE.md).
# Copy to .env.production on the server and fill in. Never commit the filled-in file.
#
# Every value marked GENERATE is made for you, with fresh random secrets, by:
#   python3 deploy/make_env.py your-name.centralindia.cloudapp.azure.com
# Then add the keys marked COPY from your local .env, and the mail settings.

# --- The server's public name (no https://, no slash) -------------------------------------
DOMAIN=

# --- Secrets made for this server: GENERATE -------------------------------------------------
SECRET_KEY=
POSTGRES_PASSWORD=
S3_ACCESS_KEY=reelforge
S3_SECRET_KEY=
RENDER_SERVICE_TOKEN=
# Encrypts the YouTube tokens kept for users. Losing it means everyone reconnects YouTube.
TOKEN_ENCRYPTION_KEY=

S3_BUCKET=reelforge-media

# --- AI and media providers: COPY from your local .env -------------------------------------
LLM_PROVIDERS=gemini,groq
GEMINI_API_KEY=
GROQ_API_KEY=
VOICE_PROVIDERS=elevenlabs,edge
ELEVENLABS_API_KEY=
STOCK_PROVIDERS=pixabay
PIXABAY_API_KEY=
IMAGE_PROVIDERS=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- YouTube: COPY. Also add https://<DOMAIN>/api/v1/connections/youtube/callback as an
# --- authorised redirect URI of the OAuth client in Google Cloud.
PUBLISH_PROVIDERS=youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Email (verification and password-reset mails). Any SMTP service with STARTTLS,
# --- for example Brevo: smtp-relay.brevo.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Must be an address the mail service lets you send from.
EMAIL_FROM=ReelForge <no-reply@example.com>

# --- Rendering: 2/3 = 720x1280 (faster on a small server); 1 = 1080x1920 --------------------
RENDER_SCALE=2/3
RENDER_TIME_LIMIT_SECONDS=5400
