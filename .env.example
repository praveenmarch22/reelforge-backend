# Optional. Copy to .env (next to docker-compose.yml) to change local settings.
# Everything has a working default for local development; nothing here is needed to start.

# Change a port if something else on your machine already uses it.
# API_PORT=5000
# POSTGRES_PORT=54320
# REDIS_PORT=63790
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MAILPIT_PORT=8025

# Address of the web app that is allowed to call the API.
# WEB_ORIGIN=http://localhost:5173

# Used to sign sessions. Any value locally; a long random value in real environments.
# SECRET_KEY=

# Rate limits (sign-up, login, emails). Set to false while experimenting locally.
# RATE_LIMITS_ENABLED=true

# AI provider keys are added here when the generation tasks are built (milestone B4).
# The prototype in pipeline/ has its own pipeline/.env.example.
