# Copy this file to .env and fill in the keys you have.
# Every provider list is a fallback order: the first one is tried, then the next.
# "mock" providers need no key and no internet; they make placeholder output for testing.

# --- Script writing (ideas, script, post caption) ---
LLM_PROVIDERS=gemini,groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Voiceover ---
# elevenlabs needs a key. edge is free and needs no key (unofficial Microsoft Edge voices).
VOICE_PROVIDERS=elevenlabs,edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
EDGE_VOICE=en-US-AriaNeural

# --- Stock video ---
STOCK_PROVIDERS=pexels
PEXELS_API_KEY=

# --- AI images ---
IMAGE_PROVIDERS=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# --- AI video (Full AI mode) ---
# Leave empty to use AI images with motion instead of AI video.
# hf_space calls a Hugging Face Space through gradio_client (pip install gradio_client).
# Open the Space in your browser, click "Use via API" and copy its endpoint name and arguments.
# HF_VIDEO_ARGS is JSON; {prompt}, {image}, {seed} and {duration} are filled in for each scene.
VIDEO_PROVIDERS=
HF_TOKEN=
HF_VIDEO_SPACE=
HF_VIDEO_API_NAME=/predict
HF_VIDEO_ARGS={"prompt": "{prompt}", "image": "{image}"}

# --- Music ---
# library reads renderer/public/music/library.json. mock makes a soft synth pad.
MUSIC_PROVIDERS=library,mock

# --- General ---
# Maximum simultaneous requests per provider
PROVIDER_CONCURRENCY=2
# Fixed seed for AI images and video where supported (keeps Full AI scenes more consistent)
SEED=42
