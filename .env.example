# Optional. Copy to .env (next to docker-compose.yml) to change local settings.
# Everything has a working default for local development; nothing here is needed to start.

# Change a port if something else on your machine already uses it.
# API_PORT=5000
# POSTGRES_PORT=54320
# REDIS_PORT=63790
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MAILPIT_PORT=8025

# Address of the web app that is allowed to call the API.
# WEB_ORIGIN=http://localhost:5173

# Used to sign sessions. Any value locally; a long random value in real environments.
# SECRET_KEY=

# Rate limits (sign-up, login, emails). Set to false while experimenting locally.
# RATE_LIMITS_ENABLED=true

# AI providers. Without keys the stack still runs: scripts use an offline stand-in and
# voiceovers use the free Edge voices. Keys stay in .env, which is never committed.
# LLM_PROVIDERS=gemini,groq
# GEMINI_API_KEY=
# GROQ_API_KEY=
# VOICE_PROVIDERS=elevenlabs,edge
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# STOCK_PROVIDERS=pixabay
# PIXABAY_API_KEY=
# IMAGE_PROVIDERS=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# The prototype in pipeline/ has its own pipeline/.env.example.
